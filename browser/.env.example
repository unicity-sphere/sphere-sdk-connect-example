# Sphere wallet URL — used for the popup (P3) fallback and as the origin your
# dApp is loaded from when testing via the custom-agent iframe.
# Defaults to the PRODUCTION hosted wallet if unset. Point it at a locally-run
# wallet (e.g. http://localhost:5173) if you run one yourself.
VITE_WALLET_URL=https://sphere.unicity.network

# Network this dApp declares in the Connect handshake: a key of the SDK's SPHERE_NETWORKS. The
# wallet refuses a mismatch with INCOMPATIBLE_NETWORK (4008). The pinned sphere-sdk 0.14.2 lists
# `testnet2` only; 0.16+ adds `mainnet`. Optional — testnet2 when unset, and an unknown value
# falls back to testnet2 with a console warning.
#
# This is only the DEFAULT: the network selector on the connect screen overrides it, and the
# pick is remembered in localStorage.
# VITE_SPHERE_NETWORK=testnet2
