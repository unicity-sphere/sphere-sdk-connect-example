# testnet2 aggregator key (public, non-secret)
AGGREGATOR_API_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590
# The bot's own wallet. Leave BOT_MNEMONIC empty on first run to auto-generate
# (the bot prints the generated mnemonic — save it). Set it to persist identity.
