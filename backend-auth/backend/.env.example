# HTTP port the Express server listens on
PORT=8787
# HMAC secret used to sign session JWTs. Dev-only value — replace in any
# real deployment (e.g. a 64-hex random string) and never commit the real one.
JWT_SECRET=dev-only-change-me
# How long an issued session JWT stays valid, in seconds
SESSION_TTL_SECONDS=7200
# Domain bound into the signed challenge string (anti-phishing: ties a
# signature to this backend so it can't be replayed against another site)
AUTH_DOMAIN=localhost
# Origin allowed to call this API (CORS) — the backend-auth frontend (Task 6)
FRONTEND_ORIGIN=http://localhost:5173
