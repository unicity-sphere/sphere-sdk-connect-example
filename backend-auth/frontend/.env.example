# Base URL of the backend-auth backend (Task 5) this frontend talks to.
VITE_BACKEND_URL=http://localhost:8787

# Wallet URL used for the popup fallback (P3) when autoConnect can't use an
# iframe or the browser extension. Only needed outside an iframe/extension
# context. Same default as the browser/ example's VITE_WALLET_URL.
VITE_WALLET_URL=https://sphere.unicity.network
