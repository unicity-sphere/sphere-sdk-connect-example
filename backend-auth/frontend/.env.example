# Base URL of the backend-auth backend (Task 5) this frontend talks to.
VITE_BACKEND_URL=http://localhost:8787

# Wallet URL used for the popup fallback (P3) when autoConnect is not running
# inside the wallet's iframe. Same default as the browser/ example's
# VITE_WALLET_URL.
#
# autoConnect also has an extension path, but the Sphere Chrome extension wallet
# is DISCONTINUED — nothing answers on it, so in practice this is iframe or popup.
# Note the popup path returns 403 against the hosted wallet: to test locally,
# load this app as a custom agent (see ../README.md), which needs an https URL.
VITE_WALLET_URL=https://sphere.unicity.network

# Which chain this dApp targets: mainnet | testnet2. Defaults to testnet2.
# A handshake whose network does not match the wallet's is refused with
# INCOMPATIBLE_NETWORK (4008) before any UI appears.
VITE_SPHERE_NETWORK=testnet2
